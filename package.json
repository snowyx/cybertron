{
  "name": "cybertron",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n world,web \"tsx watch server/src/main.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch server/src/main.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "start": "node dist-server/server/src/main.js",
    "test": "tsx --test server/*.test.js server/src/*.test.ts web/src/state/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "fastify": "5.12.8",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "ws": "8.22.2",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@napi-rs/canvas": "1.1.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "meshoptimizer": "1.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
